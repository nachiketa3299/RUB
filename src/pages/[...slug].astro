---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Page from '../layouts/Page.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.data.slug ?? post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Page title={post.data.title} description={post.data.description}>
  <nav><a href={import.meta.env.BASE_URL}>← 글 목록</a></nav>
  <article>
    <h1>{post.data.title}</h1>
    {post.data.date && <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>}
    {post.data.updated && <small> · 수정 {post.data.updated.toISOString().slice(0, 10)}</small>}
    {headings.length > 3 && (
      <details>
        <summary>목차</summary>
        <ul>
          {headings.filter(({ depth }) => depth <= 2).map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
        </ul>
      </details>
    )}
    <Content />
  </article>
  <p><a href={import.meta.env.BASE_URL}>← 글 목록</a></p>
</Page>
