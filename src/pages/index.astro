---
import { getCollection } from 'astro:content';
import PostList from '../components/PostList.astro';
import Page from '../layouts/Page.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft && !data.portfolio);
const tags = [...new Set(['일반', '코딩테스트', ...posts.flatMap(({ data }) => data.tags)])]
  .filter((tag) => posts.some(({ data }) => data.tags.includes(tag)));
---

<Page description="게임 개발과 이런저런 것들에 대해 씁니다.">
  <h1>Even Idiots Can Make Game</h1>
  <nav aria-label="글 분류">
    {tags.map((tag, index) => <><a href={`#tag-${index}`}>{tag}</a>{' '}</>)}
  </nav>
  <p><img src={`${import.meta.env.BASE_URL}logo.jpg`} width="300" height="300" alt="블로그 캐릭터 그림" /></p>
  {tags.map((tag, index) => (
    <section aria-labelledby={`tag-${index}`}>
      <h2 id={`tag-${index}`}>{tag}</h2>
      <PostList posts={posts.filter(({ data }) => data.tags.includes(tag))} />
    </section>
  ))}
</Page>
