---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---

<Page description="게임 개발과 이런저런 것들에 대해 씁니다.">
  <h1>Even Idiots Can Make Game</h1>
  <ul class="posts">
    {posts.map(({ id, data }) => (
      <li>
        <time datetime={data.date?.toISOString()}>{data.date?.toISOString().slice(0, 10) ?? '—'}</time>
        <a href={`${import.meta.env.BASE_URL}${data.slug ?? id}/`}>{data.title}</a>
      </li>
    ))}
  </ul>
</Page>
