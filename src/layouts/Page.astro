---
interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const name = 'Even Idiots Can Make Game';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${name}` : name}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={name} href={`${import.meta.env.BASE_URL}index.xml`} />
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  body { max-width: 800px; margin: 2rem auto; padding: 0 1rem; line-height: 1.6; overflow-wrap: anywhere; }
  img, video, iframe { max-width: 100%; }
  img, video { height: auto; }
  .youtube { width: 100%; height: auto; aspect-ratio: 16 / 9; border: 0; }
  pre { padding: .75rem; overflow-x: auto; line-height: 1.45; }
  pre code { overflow-wrap: normal; }
  table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
  th, td { border: 1px solid; padding: .25rem .5rem; }
  blockquote { margin-inline: 1rem; padding-left: 1rem; border-left: 2px solid #aaa; }
  figure { margin-inline: 0; }
  figcaption { color: #555; }
  .katex { display: inline-block; max-width: 100%; overflow-x: auto; vertical-align: middle; }
  math[display="block"] { display: block; overflow-x: auto; padding-block: .25rem; }
  .posts { display: grid; grid-template-columns: max-content minmax(0, 1fr); column-gap: .5rem; list-style: none; padding: 0; }
  .posts li { display: grid; grid-template-columns: subgrid; grid-column: 1 / -1; margin-bottom: .6rem; }
  .posts time { white-space: nowrap; font-variant-numeric: tabular-nums; }
  details { margin-block: 1rem; }
  summary { cursor: pointer; }
</style>
